# Copy these settings into .env.local. Never commit real values.
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/eventpass?sslmode=require"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""

# Required only for production email verification and password-reset delivery.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="EventPass <auth@your-verified-domain.com>"

# Optional. The seed script generates a one-time password if this is omitted.
DEMO_USER_EMAIL="demo@eventpass.local"
DEMO_USER_PASSWORD=""
